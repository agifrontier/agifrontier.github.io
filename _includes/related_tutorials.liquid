{% if page.related_tutorials and page.related_tutorials.size > 0 %}
  <section class="related-tutorials" aria-labelledby="related-tutorials-title">
    <h2 id="related-tutorials-title">相关文章</h2>
    <ul class="related-tutorials__list">
      {% for related_slug in page.related_tutorials %}
        {% assign related_path = '_tutorials/' | append: related_slug | append: '.md' %}
        {% assign related = site.tutorials | where: 'path', related_path | first %}
        {% if related %}
          <li>
            <a class="related-tutorials__article" href="{{ related.url | relative_url }}">
              {{- related.title | replace: '$', '' | strip_html -}}
            </a>
            {% if related.topics and related.topics.size > 0 %}
              <span class="related-tutorials__topics">
                {% for related_topic in related.topics %}
                  {% assign topic_config = site.tutorial_topics | where: 'name', related_topic | first %}
                  {% if topic_config %}
                    <a href="{{ '/topics/' | relative_url }}#{{ topic_config.slug }}">{{ related_topic }}</a>
                  {% else %}
                    {{ related_topic }}
                  {% endif %}
                  {% unless forloop.last %} · {% endunless %}
                {% endfor %}
              </span>
            {% endif %}
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  </section>
{% endif %}
