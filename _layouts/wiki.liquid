---
layout: default
---

<article class="wiki-article">
  <header class="wiki-article__header">
    <p class="wiki-article__eyebrow">
      AI Wiki{% if page.materials_count %} · {{ page.materials_count }} 条来源{% endif %}
    </p>
    <h1>{{ page.title }}</h1>
    {% if page.description %}
      <p class="wiki-article__description">{{ page.description }}</p>
    {% endif %}
    <nav class="wiki-article__meta" aria-label="Wiki 页面信息">
      <a href="{{ '/wiki/' | relative_url }}">返回 Wiki</a>
      {% if page.source_url %}
        <a href="{{ page.source_url }}" rel="external noopener">查看动态资料页</a>
      {% endif %}
      {% if page.last_modified_at %}
        <time datetime="{{ page.last_modified_at | date_to_xmlschema }}">
          更新于 {{ page.last_modified_at | date: '%Y-%m-%d' }}
        </time>
      {% endif %}
    </nav>
  </header>

  <div class="wiki-article__content">
    {{ content }}
  </div>
</article>
