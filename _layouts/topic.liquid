---
layout: default
---

{% assign topic_tutorials = site.tutorials | where_exp: "tutorial", "tutorial.topics contains page.topic_name" | sort: "seo_lastmod" | reverse %}

<div class="post topic-page">
  <nav class="topic-page__breadcrumb" aria-label="面包屑导航">
    <a href="{{ '/topics/' | relative_url }}">AI 主题导航</a>
    <span aria-hidden="true">/</span>
    <span>{{ page.topic_name }}</span>
  </nav>

  <header class="post-header topic-page__header">
    <p class="topic-page__eyebrow">AI TOPIC</p>
    <h1 class="post-title">{{ page.topic_name }}论文解读</h1>
    <p>{{ page.description }}</p>
    <p class="topic-page__count">当前收录 {{ topic_tutorials.size }} 篇论文解读</p>
  </header>

  <section aria-labelledby="topic-articles-title">
    <h2 id="topic-articles-title">{{ page.topic_name }}最新文章</h2>
    <div class="topic-page__articles">
      {% for tutorial in topic_tutorials %}
        {% assign published_date = tutorial.seo_published | default: tutorial.date %}
        <article class="topic-page__article">
          <h3><a href="{{ tutorial.url | relative_url }}">{{ tutorial.title | replace: '$', '' | strip_html }}</a></h3>
          {% if published_date %}<p class="topic-page__meta">{{ published_date | date: "%Y年%m月%d日" }}</p>{% endif %}
          {% if tutorial.description %}<p>{{ tutorial.description | strip_html | truncate: 150 }}</p>{% endif %}
        </article>
      {% endfor %}
    </div>
  </section>

  <nav class="topic-page__siblings" aria-label="其他AI主题">
    <h2>浏览其他主题</h2>
    <div>
      {% for topic in site.tutorial_topics %}
        {% unless topic.slug == page.topic_slug %}
          <a href="{{ '/topics/' | append: topic.slug | append: '/' | relative_url }}">{{ topic.name }}</a>
        {% endunless %}
      {% endfor %}
    </div>
  </nav>
</div>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": {{ page.title | jsonify }},
  "numberOfItems": {{ topic_tutorials.size }},
  "itemListElement": [
    {% for tutorial in topic_tutorials %}
      {
        "@type": "ListItem",
        "position": {{ forloop.index }},
        "url": {{ tutorial.url | absolute_url | jsonify }},
        "name": {{ tutorial.title | replace: '$', '' | strip_html | jsonify }}
      }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ]
}
</script>
